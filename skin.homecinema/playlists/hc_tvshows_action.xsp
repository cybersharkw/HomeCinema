<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Action</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Action &amp; Adventure</value>
        <value>Action</value>
    </rule>
    <limit>40</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
