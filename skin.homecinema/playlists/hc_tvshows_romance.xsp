<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Liebesfilm</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Liebesfilm</value>
        <value>Romance</value>
        <value>Soap</value>
    </rule>
    <limit>40</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
