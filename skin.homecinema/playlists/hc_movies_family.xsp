<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Familie</name>
    <match>all</match>
    <rule field="genre" operator="is">
        <value>Familie</value>
        <value>Family</value>
    </rule>
    <limit>40</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
