<?xml version="1.0" encoding="UTF-8"?>
<!-- HomeCinema Intro: Vorhang auf, Licht an. OK überspringt das Intro. -->
<window>
	<defaultcontrol>10</defaultcontrol>
	<onload condition="Skin.HasSetting(hc_skip_intro)">ReplaceWindow($INFO[System.StartupWindow])</onload>
	<onload condition="!Skin.HasSetting(hc_skip_intro)">AlarmClock(hcintro,ReplaceWindow($INFO[System.StartupWindow]),00:04,silent)</onload>
	<onunload>CancelAlarm(hcintro,true)</onunload>
	<controls>
		<control type="button" id="10">
			<left>0</left>
			<top>0</top>
			<width>1</width>
			<height>1</height>
			<texturefocus>-</texturefocus>
			<texturenofocus>-</texturenofocus>
			<onclick>ReplaceWindow($INFO[System.StartupWindow])</onclick>
			<onback>ReplaceWindow($INFO[System.StartupWindow])</onback>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>colors/black.png</texture>
		</control>
		<!-- Projektorlicht -->
		<control type="image">
			<left>560</left>
			<top>-80</top>
			<width>800</width>
			<height>1000</height>
			<texture>hc/light_cone.png</texture>
			<animation effect="fade" start="0" end="100" time="1200" delay="1300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="400">WindowClose</animation>
		</control>
		<control type="image">
			<left>710</left>
			<top>300</top>
			<width>500</width>
			<height>500</height>
			<texture colordiffuse="66E5B04A">hc/spotlight.png</texture>
			<animation effect="fade" start="0" end="100" time="1200" delay="1500">WindowOpen</animation>
			<animation effect="zoom" start="80" end="110" center="960,550" time="3500" delay="1200" tween="sine" easing="out">WindowOpen</animation>
		</control>
		<!-- Logo -->
		<control type="label">
			<left>0</left>
			<top>420</top>
			<width>1920</width>
			<height>180</height>
			<align>center</align>
			<aligny>center</aligny>
			<font>hc_display150</font>
			<textcolor>hc_text</textcolor>
			<shadowcolor>FF000000</shadowcolor>
			<label>[COLOR hc_gold]HOME[/COLOR]CINEMA</label>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="1000" delay="1400" />
				<effect type="zoom" start="80" end="100" center="960,510" time="1800" delay="1400" tween="cubic" easing="out" />
			</animation>
			<animation effect="zoom" start="100" end="115" center="960,510" time="400" tween="cubic" easing="in">WindowClose</animation>
			<animation effect="fade" start="100" end="0" time="400">WindowClose</animation>
		</control>
		<control type="label">
			<left>0</left>
			<top>610</top>
			<width>1920</width>
			<height>50</height>
			<align>center</align>
			<font>hc_text30</font>
			<textcolor>hc_text_dim</textcolor>
			<label>Film ab!</label>
			<animation effect="fade" start="0" end="100" time="800" delay="2300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
		</control>
		<!-- Vorhang -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>980</width>
			<height>1080</height>
			<texture>hc/curtain_left.png</texture>
			<animation effect="slide" start="0,0" end="-990,0" time="1800" delay="600" tween="cubic" easing="inout">WindowOpen</animation>
			<animation effect="slide" start="-990,0" end="-990,0" time="0">WindowClose</animation>
		</control>
		<control type="image">
			<left>940</left>
			<top>0</top>
			<width>980</width>
			<height>1080</height>
			<texture>hc/curtain_right.png</texture>
			<animation effect="slide" start="0,0" end="990,0" time="1800" delay="600" tween="cubic" easing="inout">WindowOpen</animation>
			<animation effect="slide" start="990,0" end="990,0" time="0">WindowClose</animation>
		</control>
		<control type="label">
			<left>0</left>
			<bottom>40</bottom>
			<width>1920</width>
			<height>40</height>
			<align>center</align>
			<font>hc_text22</font>
			<textcolor>hc_text_faint</textcolor>
			<label>OK drücken zum Überspringen</label>
			<animation effect="fade" start="0" end="100" time="600" delay="800">WindowOpen</animation>
		</control>
	</controls>
</window>
